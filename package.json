{
  "name": "semantic-variable-examples",
  "private": true,
  "version": "0.0.0",
  "description": "Two-tier (primitive/semantic) design token architecture with multi-platform build output and a polymorphic ShadCN-style React component library.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter @svx/react storybook",
    "build:storybook": "turbo run build:storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
